# LauraTV Cowatch backend
# Local development / Railway production

NODE_ENV=development
PORT=3000

# Frontend origins allowed to connect to Cowatch.
# NEVER use * in production.
CORS_ORIGINS=http://localhost:3173

# Fastify HTTP rate limiting.
# Socket.IO has separate Cowatch abuse protection.
HTTP_RATE_LIMIT_MAX=240
HTTP_RATE_LIMIT_WINDOW_MS=60000

COWATCH_MAX_PARTICIPANTS=5
COWATCH_ROOM_CODE_LENGTH=6
COWATCH_HOST_RECONNECT_GRACE_MS=30000
COWATCH_EMPTY_ROOM_EXPIRY_MS=60000
COWATCH_KICK_REJOIN_COOLDOWN_MS=15000

COWATCH_SYNC_INTERVAL_MS=2500
COWATCH_DRIFT_TOLERANCE_SECONDS=3
COWATCH_MAX_TIMELINE_SECONDS=86400

COWATCH_MAX_EVENTS_PER_WINDOW=120
COWATCH_EXTREME_EVENTS_PER_WINDOW=500

# Keep disabled until we verify Railway's forwarded-IP
# behavior during the deployment test.
COWATCH_TRUST_PROXY=false

COWATCH_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
COWATCH_MAX_SDP_LENGTH=100000
COWATCH_MAX_ICE_CANDIDATE_LENGTH=8192

COWATCH_TEMPORARY_BAN_MS=43200000

COWATCH_CHAT_MAX_MESSAGE_LENGTH=500
COWATCH_CHAT_MAX_RECENT_MESSAGES=100

COWATCH_ROOM_INACTIVITY_MS=900000
COWATCH_HEARTBEAT_INTERVAL_MS=45000
COWATCH_CLEANUP_INTERVAL_MS=600000

# Real rooms:
COWATCH_PERSISTENCE_MODE=supabase

# SERVER ONLY.
# Never copy these into web/.env or a VITE_* variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here