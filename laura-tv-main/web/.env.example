# =========================================================
# LauraTV Web
# =========================================================
#
# ALL VITE_* variables are PUBLIC.
#
# Never place:
# - Supabase service-role keys
# - database passwords
# - private API keys
# - signing credentials
# - dashboard/admin credentials
#
# in this file.
# =========================================================


# Existing IBRAX media API.
# Public URL; not a credential.
VITE_API_BASE_URL=https://ibrax-server.onrender.com/api/v1


# =========================================================
# Cowatch
# =========================================================

# Local development:
VITE_COWATCH_URL=http://localhost:3000

# Production example:
# VITE_COWATCH_URL=https://laura-tv-copy-production.up.railway.app

VITE_COWATCH_PUBLIC_URL=https://watch.theunfilteredgoose.in


# =========================================================
# LauraTV Android Releases
# =========================================================
#
# Public Supabase project URL + anon/publishable key.
#
# These values are intentionally available to browser code.
# RLS permits only public reading of the currently active
# Android release.
# =========================================================

VITE_LAURATV_SUPABASE_URL=https://YOUR-LAURATV-PROJECT.supabase.co

VITE_LAURATV_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY


# =========================================================
# Development
# =========================================================

# Not a security boundary.
VITE_DEVTOOLS_PROTECTION=false